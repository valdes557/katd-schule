PORT=5000
MONGO_URI=mongodb://localhost:27017/katd_schule
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=30d
NODE_ENV=production
CLIENT_URL=https://katdschool.com

# SMTP LWS — email professionnel
SMTP_HOST=mail.katdschool.com
SMTP_PORT=465
SMTP_USER=contact@katdschool.com
SMTP_PASS=VotreMotDePasseEmail
SMTP_FROM=contact@katdschool.com

# Clé de chiffrement des secrets (clés API Ikeepay) — AES-256-GCM
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generez_64_caracteres_hexadecimaux_ici

# Ikeepay — passerelle Mobile Money multi-pays (collectes + payouts)
# Les clés API se configurent de préférence via le dashboard admin (chiffrées en base).
# Ces variables servent de repli si aucune config DB n'existe.
IKEEPAY_MODE=test
IKEEPAY_BASE_URL=https://api.ikeepay.com/api/v1
IKEEPAY_COUNTRY=CI
IKEEPAY_CURRENCY=XOF
IKEEPAY_API_KEY_TEST=
IKEEPAY_API_KEY_LIVE=
IKEEPAY_WEBHOOK_SECRET_TEST=
IKEEPAY_WEBHOOK_SECRET_LIVE=
# Chemins/entête à confirmer avec la doc Ikeepay (valeurs par défaut raisonnables)
IKEEPAY_PAYOUT_PATH=/payouts
IKEEPAY_STATUS_PATH=/payments
IKEEPAY_SIGNATURE_HEADER=x-ikeepay-signature
# URL publique du serveur (callback_url des webhooks Ikeepay)
SERVER_URL=https://katdschool.com

# Fuseau horaire de l'application (pointage du personnel : heure locale Cameroun)
# Le VPS tourne en UTC ; ce fuseau sert aux comparaisons d'heures d'arrivée/sortie.
APP_TZ=Africa/Douala
