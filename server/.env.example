PORT=5000
MONGO_URI=mongodb://localhost:27017/katd_schule
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=30d
NODE_ENV=production
CLIENT_URL=https://katdschool.com

# SMTP LWS — email professionnel
SMTP_HOST=mail.katdschool.com
SMTP_PORT=465
SMTP_USER=contact@katdschool.com
SMTP_PASS=VotreMotDePasseEmail
SMTP_FROM=contact@katdschool.com

# Clé de chiffrement des secrets (clés API SEBPay) — AES-256-GCM
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generez_64_caracteres_hexadecimaux_ici
